# copy to .env and fill in from /costar-keys. never commit .env
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=
COSTAR_KIT_URL=
COSTAR_ZIP_PASSWORD=
ANTHROPIC_API_KEY=
# model for the deep agents (any init_chat_model spec)
# NUDGE_MODEL=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# photon beta (app.beta.photon.codes): project id starts with pho_prj_, key needs project:read + project:write
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# optional: only answer these imessage handles (comma separated)
PHOTON_ALLOWED_SENDERS=

# free models (langchain track guidance; no credits given): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# default for both is openrouter:openrouter/free; stronger fixed models need the free-endpoint privacy toggle
# NUDGE_VISION_MODEL=openrouter:nvidia/nemotron-3.5-super-vl:free

# gemini (interactions api): https://aistudio.google.com/apikey
# GEMINI_API_KEY=
